[Unit]
Description=Flood Analytics REST API
After=network.target

[Service]
User=nginx
Group=nginx
WorkingDirectory=/opt/flood
EnvironmentFile=/opt/flood/.env
ExecStart=/opt/flood/venv/bin/uvicorn flood_api:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
